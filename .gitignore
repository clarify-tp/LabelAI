# KEEP THESE (Don't ignore)
# ═══════════════════════════════════════════════════════════════════════════

# Config templates (commit these)
!.env.example
!server/.env.example
!client/.env.example

# Keep these directories (but ignore contents)
!uploads/.gitkeep
!tmp/.gitkeep

# Database migrations (keep)
!migrations/versions/
!migrations/env.py