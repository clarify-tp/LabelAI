# ─── Flask ────────────────────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/labelpadhega

# ─── Groq ─────────────────────────────────────────────────────────────────────
# Get free key at: https://console.groq.com
GROQ_API_KEY=your-groq-api-key

# ─── Supabase Auth JWT ────────────────────────────────────────────────────────
# Found at: Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ─── Brevo (email) ────────────────────────────────────────────────────────────
# Get free key at: https://app.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@labelpadhega.com
BREVO_SENDER_NAME=Label Padhega AI

# ─── Frontend URL (for CORS) ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── USDA FoodData Central (nutrition fallback) ───────────────────────────────
# Free, instant, no credit card: https://fdc.nal.usda.gov/api-guide.html
# Leave as DEMO_KEY for 30 req/day without signup.
USDA_API_KEY=DEMO_KEY

# ─── Redis cache (optional) ───────────────────────────────────────────────────
# Local Docker: redis://localhost:6379  | Upstash free tier: rediss://default:xxx@xxx.upstash.io:6379
# Leave blank to disable caching entirely (app still works).
REDIS_URL=

# ─── Sentry error monitoring (optional) ───────────────────────────────────────
# Free 5K errors/month: https://sentry.io/signup/  | Leave blank to disable.
SENTRY_DSN=

# ─── Cloudinary image storage (optional) ──────────────────────────────────────
# Free 25GB: https://cloudinary.com/users/register/free | Leave blank to disable.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
