# ─── Flask ────────────────────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/labelpadhega

# ─── Groq ─────────────────────────────────────────────────────────────────────
# Get free key at: https://console.groq.com
GROQ_API_KEY=your-groq-api-key

# ─── Supabase Auth JWT ────────────────────────────────────────────────────────
# Found at: Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ─── Brevo (email) ────────────────────────────────────────────────────────────
# Get free key at: https://app.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@labelpadhega.com
BREVO_SENDER_NAME=Label Padhega AI

# ─── Frontend URL (for CORS) ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
